{
    "openapi": "3.0.3",
    "info": {
        "title": "Users API",
        "description": "An API for managing users.",
        "contact": {
            "name": "Support",
            "email": "support@example.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "servers": [
        {
            "url": "https://api.example.com/v1",
            "description": "Production"
        }
    ],
    "paths": {
        "/users/{id}": {
            "get": {
                "tags": [
                    "users"
                ],
                "summary": "Get a user.",
                "operationId": "getUser",
                "responses": {
                    "200": {
                        "description": "The user.",
                        "headers": {
                            "X-Rate-Limit": {
                                "description": "Requests left.",
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                },
                                "example": {
                                    "id": "abc",
                                    "name": "Bob"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "oauth": [
                            "users:read"
                        ]
                    },
                    {
                        "apiKey": []
                    }
                ]
            },
            "parameters": [
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "string",
                        "format": "uuid"
                    }
                }
            ]
        },
        "/users": {
            "post": {
                "tags": [
                    "users"
                ],
                "summary": "Create a user.",
                "operationId": "createUser",
                "requestBody": {
                    "description": "The user to create.",
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/User"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "The user.",
                        "headers": {
                            "X-Rate-Limit": {
                                "description": "Requests left.",
                                "schema": {
                                    "type": "integer"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                },
                                "example": {
                                    "id": "abc",
                                    "name": "Bob"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "oauth": [
                            "users:write"
                        ]
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "description": "A user.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 255
                    },
                    "age": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "required": [
                    "id",
                    "name"
                ]
            }
        },
        "securitySchemes": {
            "oauth": {
                "type": "oauth2",
                "flows": {
                    "clientCredentials": {
                        "tokenUrl": "https://auth.example.com/token",
                        "scopes": {
                            "users:read": "Read users.",
                            "users:write": "Create users."
                        }
                    }
                }
            },
            "apiKey": {
                "type": "apiKey",
                "name": "X-API-Key",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "users",
            "description": "Managing users."
        }
    ],
    "externalDocs": {
        "url": "https://docs.example.com"
    }
}
