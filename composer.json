{
    "name": "programster/swagger",
    "type": "library",
    "description": "A package for generating OpenAPI 3.0.3 (formerly Swagger) documents, by building them from PHP objects that check themselves as they are created.",
    "keywords": [
        "openapi",
        "swagger",
        "api",
        "documentation"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "email": "sdpagent@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "ext-yaml": "*",
        "ramsey/collection": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Programster\\Swagger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programster\\Swagger\\Testing\\": "testing/"
        }
    }
}
